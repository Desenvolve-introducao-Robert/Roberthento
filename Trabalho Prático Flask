from datetime import datetime
from typing import Optional

import sqlalchemy as sa
from flask_login import UserMixin
from sqlalchemy.orm import Mapped, mapped_column, relationship

from app import db, login


class User(UserMixin, db.Model):
    __tablename__ = 'users'

    id: Mapped[int] = mapped_column(primary_key=True)
    username: Mapped[str] = mapped_column(sa.String(64), unique=True, index=True)
    password: Mapped[str] = mapped_column(sa.String(128))
    remember: Mapped[bool] = mapped_column(default=False)
    last_login: Mapped[Optional[datetime]]
    foto: Mapped[Optional[str]] = mapped_column(sa.String(500))
    bio: Mapped[Optional[str]] = mapped_column(sa.String(300))

    # Lado "um" da relação: user.posts devolve os posts do usuário
    posts: Mapped[list['Post']] = relationship(back_populates='author')

    def __repr__(self):
        return f'<User {self.username}>'


class Post(db.Model):
    __tablename__ = 'posts'

    id: Mapped[int] = mapped_column(primary_key=True)
    body: Mapped[str] = mapped_column(sa.String(280))
    timestamp: Mapped[datetime] = mapped_column(index=True, default=datetime.now)
    user_id: Mapped[int] = mapped_column(sa.ForeignKey(User.id), index=True)

    # post.author devolve o User; user_id é preenchido automaticamente
    author: Mapped[User] = relationship(back_populates='posts')

    def __repr__(self):
        return f'<Post {self.body}>'


# Usada internamente pelo Flask-Login para recuperar o usuário atual
@login.user_loader
def load_user(id):
    return db.session.get(User, int(id))
