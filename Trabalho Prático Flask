from datetime import datetime

from flask import flash, redirect, render_template, request, url_for
from flask_login import (
    current_user,   # objeto User atual
    login_required,  # decorador de rotas que exigem login
    login_user,     # método de login
    logout_user,    # método de logout
)

from app import alquimias, app, db


@app.route('/')
@login_required
def index():
    user = None
    posts = None
    if current_user.is_authenticated:
        user = current_user
        posts = alquimias.get_timeline()
    return render_template('index.html', title='Início', user=user, posts=posts)


@app.route('/login', methods=['GET', 'POST'])
def login():
    if current_user.is_authenticated:
        return redirect(url_for('index'))
    if request.method == 'POST':
        username = request.form['username'].strip().lower()
        password = request.form['password']

        user = alquimias.validate_user_password(username, password)
        if user:
            user.last_login = datetime.now()
            db.session.commit()
            login_user(user, remember=user.remember)
            return redirect(url_for('index'))
        flash('Usuário ou senha inválidos.', 'erro')
        return redirect(url_for('login'))
    # request.method == GET
    return render_template('login.html', title='Entrar')


@app.route('/cadastro', methods=['GET', 'POST'])
def cadastro():
    if current_user.is_authenticated:
        return redirect(url_for('index'))
    if request.method == 'POST':
        username = request.form['username'].strip().lower()
        password = request.form['password']
        foto = request.form.get('foto', '').strip()
        bio = request.form.get('bio', '').strip()
        remember = request.form.get('remember') == 'on'

        if not username or not password:
            flash('Usuário e senha são obrigatórios.', 'erro')
            return redirect(url_for('cadastro'))
        if foto and not foto.startswith(('http://', 'https://')):
            flash('A foto deve ser uma URL começando com http:// ou https://.', 'erro')
            return redirect(url_for('cadastro'))
        if alquimias.user_exists(username):
            flash('Usuário já existe!', 'erro')
            return redirect(url_for('login'))

        user = alquimias.create_user(username, password, remember, foto=foto, bio=bio)
        login_user(user, remember=remember)
        return redirect(url_for('index'))
    return render_template('cadastro.html', title='Cadastro')


@app.route('/logout')
def logout():
    logout_user()
    return redirect(url_for('index'))


@app.route('/post', methods=['GET', 'POST'])
@login_required
def post():
    if request.method == 'POST':
        body = request.form.get('body', '').strip()
        if not body:
            flash('O post não pode estar vazio.', 'erro')
            return redirect(url_for('post'))
        if len(body) > 280:
            flash('O post deve ter no máximo 280 caracteres.', 'erro')
            return redirect(url_for('post'))
        alquimias.create_post(body, current_user)
        return redirect(url_for('index'))
    return render_template('post.html', title='Escrever post')

:root {
  --fundo: #f4f6f8;
  --superficie: #ffffff;
  --texto: #1b1f23;
  --texto-suave: #4a5560;
  --primaria: #1d4ed8;
  --primaria-escura: #1e3a8a;
  --borda: #d0d7de;
  --erro-fundo: #fde8e8;  --erro-texto: #7f1d1d;
  --ok-fundo: #e3f6e8;    --ok-texto: #14532d;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6;
  color: var(--texto);
  background: var(--fundo);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

a { color: var(--primaria); }
a:hover { color: var(--primaria-escura); }

:focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }

.pular {
  position: absolute; left: -999px; top: 0;
  background: #000; color: #fff; padding: .5rem 1rem; z-index: 10;
}
.pular:focus { left: 0; }

.topo { background: var(--primaria); }
.topo nav {
  max-width: 760px; margin: 0 auto; padding: .75rem 1rem;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem;
}
.topo ul { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem; margin: 0; padding: 0; }
.topo a { color: #fff; text-decoration: none; font-weight: 500; padding: .25rem .1rem; }
.topo a:hover, .topo a:focus-visible { text-decoration: underline; color: #fff; }
.marca { font-size: 1.25rem; font-weight: 700 !important; }

main { flex: 1; width: 100%; max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem; }

h1, h2 { line-height: 1.25; margin-top: 0; }

.cartao {
  background: var(--superficie);
  border: 1px solid var(--borda);
  border-radius: 10px;
  padding: 1.25rem;
  margin-bottom: 1rem;
}

.perfil { display: flex; gap: 1.25rem; align-items: center; }
.avatar {
  width: 96px; height: 96px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
  border: 2px solid var(--borda);
}
.avatar.pequeno { width: 44px; height: 44px; }
.avatar.sem-foto {
  display: flex; align-items: center; justify-content: center;
  background: var(--primaria); color: #fff; font-size: 2rem; font-weight: 700;
}
.avatar.pequeno.sem-foto { font-size: 1.1rem; }

.lista-posts { list-style: none; padding: 0; margin: 0; }
.post .autor { display: flex; align-items: center; gap: .75rem; margin-bottom: .5rem; }
.post time { display: block; font-size: .85rem; color: var(--texto-suave); }
.post p { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }

.formulario { max-width: 520px; margin-left: auto; margin-right: auto; }
.campo { margin-bottom: 1rem; }
.campo label { display: block; font-weight: 600; margin-bottom: .25rem; }
.campo small { display: block; color: var(--texto-suave); margin-top: .25rem; }
.campo.check { display: flex; align-items: center; gap: .5rem; }
.campo.check label { margin: 0; font-weight: 400; }

input[type="text"], input[type="password"], input[type="url"], textarea {
  width: 100%; padding: .6rem .75rem; font: inherit;
  border: 1px solid #8b949e; border-radius: 6px; background: #fff; color: var(--texto);
}
textarea { resize: vertical; }

.botao {
  display: inline-block; padding: .6rem 1.2rem; font: inherit; font-weight: 600;
  background: var(--primaria); color: #fff; border: 2px solid var(--primaria);
  border-radius: 6px; text-decoration: none; cursor: pointer;
}
.botao:hover { background: var(--primaria-escura); border-color: var(--primaria-escura); color: #fff; }
.botao.secundario { background: transparent; color: var(--primaria); }
.botao.secundario:hover { background: #e8eefc; color: var(--primaria-escura); }

.mensagem { padding: .75rem 1rem; border-radius: 6px; margin: 0 0 .5rem; font-weight: 500; }
.mensagem.erro { background: var(--erro-fundo); color: var(--erro-texto); }
.mensagem.sucesso { background: var(--ok-fundo); color: var(--ok-texto); }

.rodape { text-align: center; color: var(--texto-suave); padding: 1rem; font-size: .9rem; }

@media (max-width: 520px) {
