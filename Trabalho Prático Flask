# Todas as funções de usuário retornam o objeto User (ou None).
from datetime import datetime

import sqlalchemy as sa

from app import db
from app.models.models import Post, User


def validate_user_password(username, password):
    res = db.session.execute(sa.select(User).where(User.username == username))
    user = res.scalars().first()
    if user and user.password == password:
        return user
    return None


def user_exists(username):
    res = db.session.execute(sa.select(User).where(User.username == username))
    user = res.scalars().first()
    return user


def create_user(username, password, remember=False, last_login=None, foto=None, bio=None):
    new_user = User(
        username=username,
        password=password,
        remember=remember,
        last_login=last_login or datetime.now(),
        foto=foto or None,
        bio=bio or None,
    )
    db.session.add(new_user)
    db.session.commit()
    return new_user


def create_post(body, user):
    """Cria um post para o usuário autenticado (user_id vem do relationship)."""
    new_post = Post(body=body, author=user)
    db.session.add(new_post)
    db.session.commit()
    return new_post


def get_timeline():
    """Os 5 posts mais recentes. Sem join: post.author já traz o usuário."""
    query = sa.select(Post).order_by(Post.timestamp.desc()).limit(5)
    return db.session.execute(query).scalars().all()

