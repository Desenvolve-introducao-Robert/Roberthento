{% extends "base.html" %}

{% block content %}
  {% if user %}
    <section class="cartao perfil" aria-labelledby="titulo-perfil">
      {% if user.foto %}
        <img class="avatar" src="{{ user.foto }}" alt="Foto de perfil de {{ user.username }}">
      {% else %}
        <div class="avatar sem-foto" role="img" aria-label="{{ user.username }} não tem foto de perfil">{{ user.username[0]|upper }}</div>
      {% endif %}
      <div>
        <h1 id="titulo-perfil">Olá, {{ user.username }}!</h1>
        <p>{{ user.bio if user.bio else "Você ainda não escreveu uma bio." }}</p>
        <a class="botao" href="{{ url_for('post') }}">Escrever post</a>
      </div>
    </section>

    <section aria-labelledby="titulo-timeline">
      <h2 id="titulo-timeline">Posts recentes</h2>
      {% if posts %}
        <ul class="lista-posts">
          {% for p in posts %}
            <li class="cartao post">
              <div class="autor">
                {% if p.author.foto %}
                  <img class="avatar pequeno" src="{{ p.author.foto }}" alt="Foto de perfil de {{ p.author.username }}">
                {% else %}
                  <div class="avatar pequeno sem-foto" aria-hidden="true">{{ p.author.username[0]|upper }}</div>
                {% endif %}
                <div>
                  <strong>{{ p.author.username }}</strong>
                  <time datetime="{{ p.timestamp.isoformat() }}">{{ p.timestamp.strftime('%d/%m/%Y às %H:%M') }}</time>
                </div>
              </div>
              <p>{{ p.body }}</p>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>Ainda não há posts. Que tal escrever o primeiro?</p>
      {% endif %}
    </section>
  {% else %}
    <section class="cartao boas-vindas">
      <h1>Bem-vindo ao Microblog</h1>
      <p>Entre ou crie uma conta para ver e escrever posts.</p>
      <p>
        <a class="botao" href="{{ url_for('login') }}">Entrar</a>
        <a class="botao secundario" href="{{ url_for('cadastro') }}">Cadastro</a>
      </p>
    </section>
  {% endif %}
{% endblock %}

